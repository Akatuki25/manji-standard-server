{
  "name": "manji-standard-server-ts-hono",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "proto:gen": "buf generate",
    "proto:clean": "rm -rf src/domain/entity/*.gen.ts src/domain/repository/*.gen.ts src/domain/repository/mock src/infra/repository/*.gen.ts src/usecase/*.gen.ts src/handler/*.gen.ts src/lib/handler-registry.gen.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.45.0",
    "@bufbuild/protoplugin": "^1.10.0",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}

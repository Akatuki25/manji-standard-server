    "@bufbuild/protoplugin": "^1.10.0",
    "@connectrpc/protoc-gen-connect-es": "^1.6.0",
    "@types/node": "^20.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
